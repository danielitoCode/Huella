# =============================================================================
# Huella — variables de entorno (local)
# Copia este archivo:  cp .env.example .env
# Rellena los valores desde la Appwrite Console y el resto de proveedores.
# Nunca subas .env a git (.gitignore ya lo excluye).
# =============================================================================

# -----------------------------------------------------------------------------
# App (pública / front)
# -----------------------------------------------------------------------------
# URL base de la app en local o staging (enlaces de tracking, callbacks)
PUBLIC_APP_URL=http://localhost:5173

# Prefijo VITE_ = expuestas al navegador vía import.meta.env (solo datos no secretos)
VITE_PUBLIC_APP_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Appwrite — cliente (Web SDK / Vite)
# Console → Project Settings → API Endpoint + Project ID
# Platforms → Web → hostname localhost (y tu dominio en prod)
# -----------------------------------------------------------------------------
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=<PROJECT_ID>

# Opcional en desarrollo: Dev Key (Overview → Integrations → Dev keys)
# Evita límites de abuso y problemas de CORS en local. NO usar en producción.
# VITE_APPWRITE_DEV_KEY=<DEV_KEY>

# -----------------------------------------------------------------------------
# Appwrite — servidor (node-appwrite / functions / scripts locales)
# Mismos endpoint y project; la API Key NUNCA lleva prefijo VITE_
# Console → Overview → Integrations → API keys (scopes mínimos necesarios)
# -----------------------------------------------------------------------------
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<PROJECT_ID>
APPWRITE_API_KEY=<API_KEY_CON_SCOPES>

# Self-hosted only (certificado autofirmado en local). En Cloud no hace falta.
# APPWRITE_SELF_SIGNED=false

# -----------------------------------------------------------------------------
# Appwrite — recursos del proyecto Huella
# Se crean en Databases / Storage; copia los IDs desde la Console
# -----------------------------------------------------------------------------
APPWRITE_DATABASE_ID=huella
APPWRITE_COLLECTION_SOLICITUDES_ID=solicitudes
APPWRITE_COLLECTION_OPERADORES_ID=operadores
# APPWRITE_BUCKET_ADJUNTOS_ID=adjuntos

# Expuestos al front solo si el cliente lee colecciones con permisos de documento
VITE_APPWRITE_DATABASE_ID=huella
VITE_APPWRITE_COLLECTION_SOLICITUDES_ID=solicitudes

# -----------------------------------------------------------------------------
# Didit (KYC) — solo servidor / functions
# -----------------------------------------------------------------------------
DIDIT_API_KEY=<DIDIT_API_KEY>
DIDIT_WORKFLOW_ID=<DIDIT_WORKFLOW_ID>
DIDIT_WEBHOOK_SECRET=<DIDIT_WEBHOOK_SECRET>

# -----------------------------------------------------------------------------
# Email (proveedor a elegir: Resend, SES, etc.) — solo servidor
# -----------------------------------------------------------------------------
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Huella <noreply@tudominio.com>

# -----------------------------------------------------------------------------
# Auth operadores (fase 1, si no usas solo Appwrite Account)
# -----------------------------------------------------------------------------
# JWT_SECRET=<cadena_larga_aleatoria>
# SESSION_SECRET=<cadena_larga_aleatoria>
